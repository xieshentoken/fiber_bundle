{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tkc.native-structure-selections/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha256",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "tkc.native-structure-selections/v0.1"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "start",
          "end",
          "span_sha256"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "span_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
